# Tabeeby - Root Environment Configuration Example
# The full application lives in tabeeby-healthcare-os/ (see its own .env.example).
# Copy the inner file to configure: cp tabeeby-healthcare-os/.env.example tabeeby-healthcare-os/.env
# This root file documents the shared base variables.

# ---- Core ----
TABEEBY_ENV=development
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tabeeby
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
JWT_SECRET_KEY=generate-a-long-random-value
ENCRYPTION_KEY=generate-a-long-random-value

# ---- Databases ----
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
QDRANT_URL=http://localhost:6333

# ---- External APIs (optional) ----
PUBMED_KEY=
CT_API=

# ---- Notifications (disabled by default) ----
SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
PUSH_PROVIDER=disabled

# ---- Runtime limits ----
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
